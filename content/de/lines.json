  "t1_ballon_intro": {
   "t": 1,
   "lang": "de",
   "text": "Wir blasen einen Luftballon auf. Puste hinein!"
  },
  "t1_ballon2": {
   "t": 1,
   "lang": "de",
   "text": "Noch mehr Luft!"
  },
  "t1_ru_ballon": {
   "t": 1,
   "lang": "ru",
   "text": "Надуй шарик! Дуй сильнее!"
  },
  "t1_ballon_ende": {
   "t": 1,
   "lang": "de",
   "text": "Huiii, der Ballon fliegt weg!"
  },
  "t1_floete_intro": {
   "t": 1,
   "lang": "de",
   "text": "Das ist eine Zauberflöte. Wenn du pustest, spielt sie ein Lied!"
  },
  "t1_floete2": {
   "t": 1,
   "lang": "de",
   "text": "Weiter pusten, die Musik spielt!"
  },
  "t1_ru_floete": {
   "t": 1,
   "lang": "ru",
   "text": "Подуй в дудочку — она заиграет песенку!"
  },
  "t1_suppe_intro": {
   "t": 1,
   "lang": "de",
   "text": "Die Suppe ist noch heiß! Puste, damit sie kalt wird."
  },
  "t1_suppe2": {
   "t": 1,
   "lang": "de",
   "text": "Noch ein bisschen pusten!"
  },
  "t1_ru_suppe": {
   "t": 1,
   "lang": "ru",
   "text": "Суп горячий! Подуй, чтобы он остыл."
  },
  "t1_suppe_ende": {
   "t": 1,
   "lang": "de",
   "text": "Jetzt kann der Bär essen. Lecker!"
  },
  "t1_blasen_intro": {
   "t": 1,
   "lang": "de",
   "text": "Seifenblasen! Puste ganz sanft und lang."
  },
  "t1_blasen2": {
   "t": 1,
   "lang": "de",
   "text": "Noch mehr Seifenblasen!"
  },
  "t1_ru_blasen": {
   "t": 1,
   "lang": "ru",
   "text": "Подуй тихонько — полетят мыльные пузыри!"
  },
  "t1_windrad_intro": {
   "t": 1,
   "lang": "de",
   "text": "Das Windrad dreht sich, wenn du pustest!"
  },
  "t1_windrad2": {
   "t": 1,
   "lang": "de",
   "text": "Weiter pusten, es dreht sich!"
  },
  "t1_ru_windrad": {
   "t": 1,
   "lang": "ru",
   "text": "Подуй на вертушку, чтобы она крутилась!"
  },
  "t1_blaetter_intro": {
   "t": 1,
   "lang": "de",
   "text": "Unter den Blättern ist etwas versteckt. Puste sie weg!"
  },
  "t1_blaetter2": {
   "t": 1,
   "lang": "de",
   "text": "Weiter pusten, gleich siehst du es!"
  },
  "t1_ru_blaetter": {
   "t": 1,
   "lang": "ru",
   "text": "Сдуй листики — под ними сюрприз!"
  },
  "t1_wolke_intro": {
   "t": 1,
   "lang": "de",
   "text": "Die Wolke versteckt die Sonne. Puste sie weg!"
  },
  "t1_wolke2": {
   "t": 1,
   "lang": "de",
   "text": "Weiter pusten!"
  },
  "t1_ru_wolke": {
   "t": 1,
   "lang": "ru",
   "text": "Сдуй тучку, чтобы выглянуло солнышко!"
  },
  "t1_rennen_intro": {
   "t": 1,
   "lang": "de",
   "text": "Wettrennen! Mein Boot gegen dein Boot. Puste dein Boot ins Ziel!"
  },
  "t1_rennen2": {
   "t": 1,
   "lang": "de",
   "text": "Schneller pusten, du schaffst es!"
  },
  "t1_ru_rennen": {
   "t": 1,
   "lang": "ru",
   "text": "Гонка! Дуй на свой кораблик, чтобы он приплыл первым!"
  },
  "t1_rennen_sieg": {
   "t": 1,
   "lang": "de",
   "text": "Du hast gewonnen! Super gepustet!"
  },
  "t1_rennen_ende": {
   "t": 1,
   "lang": "de",
   "text": "Wir sind beide im Ziel!"
  },
  "t1_los2": {
   "t": 1,
   "lang": "de",
   "text": "Auf geht's!"
  },
  "t1_los3": {
   "t": 1,
   "lang": "de",
   "text": "Bist du bereit? Dann los!"
  },
  "t2_los2": {
   "t": 2,
   "lang": "de",
   "text": "Ohren auf! Los geht's."
  },
  "t2_los3": {
   "t": 2,
   "lang": "de",
   "text": "Jetzt hören wir ganz genau hin."
  },
  "t3_los2": {
   "t": 3,
   "lang": "de",
   "text": "Auf geht's!"
  },
  "t3_los3": {
   "t": 3,
   "lang": "de",
   "text": "Bist du bereit? Dann los!"
  },
  "t3_station_fertig2": {
   "t": 3,
   "lang": "de",
   "text": "Super! Noch ein Stern für dich!"
  },
  "t3_station_fertig3": {
   "t": 3,
   "lang": "de",
   "text": "Toll gemacht! Der Stern gehört dir!"
  },
  "t3_stopptanz": {
   "t": 3,
   "lang": "de",
   "text": "Stopptanz! Wenn die Musik aufhört, bleibst du stehen wie eine Statue!"
  },
  "t3_stopp": {
   "t": 3,
   "lang": "de",
   "text": "Stopp! Nicht bewegen!"
  },
  "t3_stopp2": {
   "t": 3,
   "lang": "de",
   "text": "Stopp! Wie eine Statue!"
  },
  "t3_tanz_weiter": {
   "t": 3,
   "lang": "de",
   "text": "Und weiter!"
  },
  "t3_tanz_weiter2": {
   "t": 3,
   "lang": "de",
   "text": "Weiter tanzen!"
  },
  "t3_g_rakete_ende": {
   "t": 3,
   "lang": "de",
   "text": "Die Rakete fliegt zu den Sternen!"
  },
  "t3_g_zug_intro": {
   "t": 3,
   "lang": "de",
   "text": "Wir bauen einen Zug! Jedes Wort ist ein Wagen."
  },
  "t3_g_zug_ru": {
   "t": 3,
   "lang": "ru",
   "text": "Скажи слово — и прицепим вагончик!"
  },
  "t3_g_zug_ende": {
   "t": 3,
   "lang": "de",
   "text": "Tschu-tschu! Der Zug fährt los!"
  },
  "t3_g_turm_intro": {
   "t": 3,
   "lang": "de",
   "text": "Wir bauen einen hohen Turm! Jedes Wort ist ein Stein."
  },
  "t3_g_turm_ru": {
   "t": 3,
   "lang": "ru",
   "text": "Скажи слово — и положим кубик!"
  },
  "t3_g_turm_ende": {
   "t": 3,
   "lang": "de",
   "text": "So ein hoher Turm! Super!"
  },
  "t3_g_ballons_intro": {
   "t": 3,
   "lang": "de",
   "text": "Jedes Wort bekommt einen Luftballon!"
  },
  "t3_g_ballons_ru": {
   "t": 3,
   "lang": "ru",
   "text": "Скажи слово — и шарик полетит!"
  },
  "t3_g_ballons_ende": {
   "t": 3,
   "lang": "de",
   "text": "Alle Ballons fliegen hoch in den Himmel!"
  },
  "t3_g_blumen_intro": {
   "t": 3,
   "lang": "de",
   "text": "Wir pflanzen einen Garten! Bei jedem Wort wächst eine Blume."
  },
  "t3_g_blumen_ru": {
   "t": 3,
   "lang": "ru",
   "text": "Скажи слово — и вырастет цветок!"
  },
  "t3_g_blumen_ende": {
   "t": 3,
   "lang": "de",
   "text": "Was für ein schöner Garten!"
  },
  "t3_g_angeln_intro": {
   "t": 3,
   "lang": "de",
   "text": "Wir gehen angeln! Sag das Wort, dann fängst du den Fisch."
  },
  "t3_g_angeln_ru": {
   "t": 3,
   "lang": "ru",
   "text": "Скажи слово — и поймаешь рыбку!"
  },
  "t3_g_angeln_ende": {
   "t": 3,
   "lang": "de",
   "text": "Der Eimer ist voll! Toll geangelt!"
  },
  "t3_g_puzzle_intro": {
   "t": 3,
   "lang": "de",
   "text": "Hier ist jemand versteckt! Jedes Wort zeigt ein Stück."
  },
  "t3_g_puzzle_ru": {
   "t": 3,
   "lang": "ru",
   "text": "Скажи слово — и откроется кусочек картинки!"
  },
  "t3_g_puzzle_ende": {
   "t": 3,
   "lang": "de",
   "text": "Schau mal, wer da ist!"
  },
  "t3_g_geschenke_intro": {
   "t": 3,
   "lang": "de",
   "text": "So viele Geschenke! Was ist wohl drin?"
  },
  "t3_g_geschenke_ru": {
   "t": 3,
   "lang": "ru",
   "text": "Скажи слово — и откроем следующий подарок!"
  },
  "t3_g_geschenke_ende": {
   "t": 3,
   "lang": "de",
   "text": "Alle Geschenke sind offen!"
  },
  "t3_g_feuerwerk_intro": {
   "t": 3,
   "lang": "de",
   "text": "Jedes Wort macht ein Feuerwerk!"
  },
  "t3_g_feuerwerk_ru": {
   "t": 3,
   "lang": "ru",
   "text": "Скажи слово — и будет салют!"
  },
  "t3_g_feuerwerk_ende": {
   "t": 3,
   "lang": "de",
   "text": "Oh, wie schön! Was für ein Feuerwerk!"
  },
  "t3_g_schneemann_intro": {
   "t": 3,
   "lang": "de",
   "text": "Wir bauen einen Schneemann! Jedes Wort bringt ein Stück."
  },
  "t3_g_schneemann_ru": {
   "t": 3,
   "lang": "ru",
   "text": "Скажи слово — и снеговик подрастёт!"
  },
  "t3_g_schneemann_ende": {
   "t": 3,
   "lang": "de",
   "text": "Fertig! Der Schneemann winkt dir!"
  },
  "t3_g_weg_intro": {
   "t": 3,
   "lang": "de",
   "text": "Hüpf über die Steine zum Schatz! Jedes Wort ist ein Sprung."
  },
  "t3_g_weg_ru": {
   "t": 3,
   "lang": "ru",
   "text": "Скажи слово — и прыгнем на камешек!"
  },
  "t3_g_weg_ende": {
   "t": 3,
   "lang": "de",
   "text": "Du hast den Schatz gefunden!"
  },
  "t3_s_tomate": {
   "t": 3,
   "lang": "de",
   "text": "Das ist eine Tomate."
  },
  "t3_w_tomate": {
   "t": 3,
   "lang": "de",
   "text": "Tomate!"
  },
  "t3_s_tisch": {
   "t": 3,
   "lang": "de",
   "text": "Das ist ein Tisch."
  },
  "t3_w_tisch": {
   "t": 3,
   "lang": "de",
   "text": "Tisch!"
  },
  "t1_pfannkuchen": {
   "t": 1,
   "lang": "de",
   "text": "Die Zunge ist ein Pfannkuchen! Leg sie breit und weich auf die Unterlippe."
  },
  "t1_pfannkuchen2": {
   "t": 1,
   "lang": "de",
   "text": "Ganz breit und ruhig liegen lassen!"
  },
  "t1_ru_pfannkuchen": {
   "t": 1,
   "lang": "ru",
   "text": "Положи широкий язычок на нижнюю губу, как блинчик. И подержи спокойно."
  },
  "t1_nadel": {
   "t": 1,
   "lang": "de",
   "text": "Jetzt wird die Zunge spitz wie eine Nadel! Streck sie raus."
  },
  "t1_nadel2": {
   "t": 1,
   "lang": "de",
   "text": "Ganz spitz und dünn!"
  },
  "t1_ru_nadel": {
   "t": 1,
   "lang": "ru",
   "text": "Высуни язычок узким и острым, как иголочка."
  },
  "t1_tasse": {
   "t": 1,
   "lang": "de",
   "text": "Die Zunge ist eine Tasse! Zunge raus und die Ränder hoch."
  },
  "t1_tasse2": {
   "t": 1,
   "lang": "de",
   "text": "Mach eine kleine Tasse!"
  },
  "t1_ru_tasse": {
   "t": 1,
   "lang": "ru",
   "text": "Высуни широкий язычок и подними края — получится чашечка."
  },
  "t1_zaun": {
   "t": 1,
   "lang": "de",
   "text": "Zeig deine Zähne wie einen Zaun! Lächeln, die Zähne bleiben zusammen."
  },
  "t1_zaun2": {
   "t": 1,
   "lang": "de",
   "text": "Großes Lächeln mit Zähnen!"
  },
  "t1_ru_zaun": {
   "t": 1,
   "lang": "ru",
   "text": "Улыбнись широко, чтобы были видны зубки, — заборчик."
  },
  "t1_berg": {
   "t": 1,
   "lang": "de",
   "text": "Die Zunge macht einen Berg! Mund auf, die Spitze unten an die Zähne, und die Zunge hoch."
  },
  "t1_berg2": {
   "t": 1,
   "lang": "de",
   "text": "Spitze unten, der Berg geht hoch!"
  },
  "t1_ru_berg": {
   "t": 1,
   "lang": "ru",
   "text": "Открой рот, кончик языка упри в нижние зубки, а спинку подними горкой."
  },
  "t1_pilz": {
   "t": 1,
   "lang": "de",
   "text": "Die Zunge ist ein Pilz! Saug sie oben fest und mach den Mund auf."
  },
  "t1_pilz2": {
   "t": 1,
   "lang": "de",
   "text": "Zunge oben festkleben, Mund auf!"
  },
  "t1_ru_pilz": {
   "t": 1,
   "lang": "ru",
   "text": "Присоси язычок к нёбу и открой рот — получится грибок."
  },
  "t1_schaukel": {
   "t": 1,
   "lang": "de",
   "text": "Die Zunge schaukelt! Hoch zu den oberen Zähnen, runter zu den unteren."
  },
  "t1_schaukel2": {
   "t": 1,
   "lang": "de",
   "text": "Hoch, runter, hoch, runter!"
  },
  "t1_ru_schaukel": {
   "t": 1,
   "lang": "ru",
   "text": "Рот открыт, язычок качается: вверх к верхним зубкам, вниз к нижним."
  },
  "t1_maler": {
   "t": 1,
   "lang": "de",
   "text": "Die Zunge ist ein Pinsel. Mal oben den Gaumen an, von vorne nach hinten!"
  },
  "t1_maler2": {
   "t": 1,
   "lang": "de",
   "text": "Langsam malen, von vorne nach hinten!"
  },
  "t1_ru_maler": {
   "t": 1,
   "lang": "ru",
   "text": "Язычок — кисточка. Погладь им нёбо от зубов назад."
  },
  "t1_zaehne": {
   "t": 1,
   "lang": "de",
   "text": "Wir putzen die Zähne mit der Zunge! Erst oben, dann unten."
  },
  "t1_zaehne2": {
   "t": 1,
   "lang": "de",
   "text": "Putz, putz, putz!"
  },
  "t1_ru_zaehne": {
   "t": 1,
   "lang": "ru",
   "text": "Почисти зубки язычком изнутри: сначала верхние, потом нижние."
  },
  "t1_pferd_intro": {
   "t": 1,
   "lang": "de",
   "text": "Das Pferdchen läuft, wenn du mit der Zunge klickst! Zunge oben ansaugen und klack!"
  },
  "t1_pferd2": {
   "t": 1,
   "lang": "de",
   "text": "Klick mit der Zunge! Klack, klack!"
  },
  "t1_ru_pferd": {
   "t": 1,
   "lang": "ru",
   "text": "Пощёлкай язычком, как лошадка цокает копытами!"
  },
  "t1_pferd_ende": {
   "t": 1,
   "lang": "de",
   "text": "Das Pferdchen ist im Stall. Danke!"
  },
  "t1_fussball_intro": {
   "t": 1,
   "lang": "de",
   "text": "Fußball! Leg die breite Zunge auf die Unterlippe und puste den Ball ins Tor."
  },
  "t1_fussball2": {
   "t": 1,
   "lang": "de",
   "text": "Zunge vorne, und puste!"
  },
  "t1_ru_fussball": {
   "t": 1,
   "lang": "ru",
   "text": "Положи широкий язычок на нижнюю губу и подуй — загони мяч в ворота!"
  },
  "t1_fussball_tor": {
   "t": 1,
   "lang": "de",
   "text": "Tor! Super!"
  }
 }
}
